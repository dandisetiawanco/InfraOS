# InfraOS environment configuration
# Copy to .env for local overrides. Never commit .env or real secrets.

# Deployment profile: lightweight | infrastructure | production
INFRAOS_PROFILE=lightweight

# HTTP server
INFRAOS_API_HOST=127.0.0.1
INFRAOS_API_PORT=8080
INFRAOS_WEB_URL=http://localhost:3000
INFRAOS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
INFRAOS_EXPOSE_API_DOCS=true

# Database: sqlite | postgres
INFRAOS_DB_DRIVER=sqlite
INFRAOS_SQLITE_PATH=./data/infraos.db
# For infrastructure / production profiles:
# INFRAOS_DB_DRIVER=postgres
# INFRAOS_POSTGRES_DSN=postgres://infraos:change-me@127.0.0.1:5432/infraos?sslmode=disable

# Optional Redis (infrastructure / production profiles)
INFRAOS_REDIS_ADDR=

# Security (generate strong random values in production)
INFRAOS_SESSION_TTL_HOURS=24
INFRAOS_COOKIE_SECURE=false
INFRAOS_LOGIN_RATE_LIMIT_PER_MIN=10

# Service monitoring SSRF controls
# Comma-separated explicit local targets allowed in lightweight development only.
# Example: http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8090
INFRAOS_MONITORING_LOCAL_ALLOWLIST=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8090,http://localhost:8090
INFRAOS_MONITORING_MAX_CONCURRENCY=16

# Optional Docker integration (read-only inspection by default; disabled unless explicitly enabled)
INFRAOS_DOCKER_ENABLED=false
INFRAOS_DOCKER_SOCKET=/var/run/docker.sock
INFRAOS_DOCKER_ALLOW_MUTATIONS=false
INFRAOS_DOCKER_MUTATION_ALLOWLIST=

# Optional external AI incident summarization (disabled by default)
# Supported providers: disabled | openai | gemini | ollama
INFRAOS_AI_PROVIDER=disabled
INFRAOS_AI_ENDPOINT=
INFRAOS_AI_API_KEY=
INFRAOS_AI_MODEL=

# Optional OpenTelemetry export (disabled by default)
INFRAOS_OTEL_ENABLED=false
INFRAOS_OTEL_EXPORTER_ENDPOINT=

# Retention windows
INFRAOS_METRICS_RETENTION_DAYS=7
INFRAOS_LOGS_RETENTION_DAYS=14
INFRAOS_CHECKS_RETENTION_DAYS=14

# Local agent defaults
INFRAOS_AGENT_API_URL=http://127.0.0.1:8080
INFRAOS_AGENT_INTERVAL_SECONDS=10
INFRAOS_AGENT_CREDENTIALS_PATH=./.infraos/agent-credentials.json
INFRAOS_AGENT_ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
