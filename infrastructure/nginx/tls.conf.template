# Production TLS reverse proxy template for authorized Linux environments.
# Provision real certificates with certbot or your organization's PKI before enabling.
# Do not deploy self-signed certificates to public production endpoints.

server {
    listen 80;
    listen [::]:80;
    server_name infraos.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name infraos.example.com;

    ssl_certificate /etc/letsencrypt/live/infraos.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/infraos.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:InfraOSTLS:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    include /etc/nginx/conf.d/infraos-locations.inc;
}
